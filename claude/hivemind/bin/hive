#!/usr/bin/env zsh
# hive — hivemind: cross-machine sync daemon for global agent instructions/memories.
# One mind, many machines. Deterministic zsh engines own snapshot/plan/apply and
# every git write; an agent playbook session owns only reconciliation judgment.
set -u
script_path=${0:A}
daemon_dir=${script_path:h:h}

hive_usage() {
  cat <<'EOF'
hive — hivemind: sync global agent instructions/memories across machines

The ledger lives in the Profiles repo under agent-sync/:
  machines/<host>/   per-machine snapshot of global surfaces (+ manifest.json)
  golden/            the reconciled truth set both machines converge to
  state.json         golden timestamp + per-host applied markers

Usage:
  hive [sync]            Full flow as an agent playbook session: snapshot this
                         machine, plan, then apply-golden / reconcile / report.
                         Always operates from the Profiles directory.
  hive snapshot          Deterministic: pull, snapshot this machine's surfaces
                         into agent-sync/machines/<host>/, commit + push.
  hive plan              Deterministic, read-only: print the next action
                         (NEED_OTHER_MACHINE | APPLY_GOLDEN | STALE_OTHER |
                          IN_SYNC | RECONCILE) as key=value lines.
  hive apply             Deterministic: overwrite live surfaces from golden/
                         (backs everything up first), mark applied, re-snapshot.
  hive golden init --from <host>       Seed golden/ from a machine snapshot.
  hive golden finalize --hosts <A,B>   Stamp golden manifest + state, push.
  hive status            Ledger overview: hosts, ages, golden, sync state.
  hive diff [--golden | <hostA> <hostB>]   Content diff between snapshots.
  hive doctor            Environment health checks.
  hive help              This help.

Agent selection (sync only):
  hive --agent claude|codex|devin sync     (shorthands: --claude --codex --devin
                                            model-pinned: --co --cf)
Config (env):
  HIVE_PROFILES_DIR   Profiles repo (default ~/Profiles)
  HIVE_MAX_AGE_HOURS  other-machine freshness window (default 24)
  HIVE_LAUNCHER       agent launcher for sync (default cf)
  HIVE_FORCE=1        reconcile even when the other snapshot is stale
  HIVE_STATE_DIR      backups dir (default ~/.local/state/hivemind)
EOF
}

hive_source_engines() {
  source "${daemon_dir}/lib/common.zsh"
  source "${daemon_dir}/config/surfaces.zsh"
  source "${daemon_dir}/lib/collect.zsh"
  source "${daemon_dir}/lib/plan.zsh"
  source "${daemon_dir}/lib/golden.zsh"
  source "${daemon_dir}/lib/apply.zsh"
  source "${daemon_dir}/lib/status.zsh"
  source "${daemon_dir}/lib/doctor.zsh"
}

hive_build_prompt() {
  cat "${daemon_dir}/playbooks/_common.md" "${daemon_dir}/playbooks/sync.md"
  print -r -- ""
  print -r -- "## Run context"
  print -r -- "- today: $(date +%F)"
  print -r -- "- this machine: ${HIVE_HOST}"
  print -r -- "- profiles dir (ALWAYS work from here): ${HIVE_PROFILES_DIR}"
  print -r -- "- daemon dir: ${daemon_dir}"
  print -r -- "- engine entrypoint: zsh ${daemon_dir}/bin/hive <command>"
  print -r -- "- freshness window: ${HIVE_MAX_AGE_HOURS} hours"
}

hive_launch() {
  local prompt="$1"
  local launcher="${HIVE_LAUNCHER:-cf}"
  if [[ -n "${HIVE_PRINT_LAUNCHER:-}" ]]; then
    print -r -- "$launcher"
    return 0
  fi
  if [[ -n "${HIVE_DRY_LAUNCH:-}" ]]; then
    print -r -- "$prompt"
    return 0
  fi
  # Launchers (cf, co, cxscb, deo, ...) are interactive-only zsh functions;
  # resolve them inside an interactive shell, same as ghw/dag.
  cd "$HIVE_PROFILES_DIR" || exit 1
  exec zsh -ic "${launcher} $(printf '%q' "$prompt")"
}

main() {
  # Agent/launcher flags precede the command.
  while (( $# )); do
    case "${1:-}" in
      --agent)
        case "${2:-}" in
          claude) HIVE_LAUNCHER=cf ;;
          codex)  HIVE_LAUNCHER=cxscb ;;
          devin)  HIVE_LAUNCHER=deo ;;
          *) print -ru2 -- "hive: --agent expects claude|codex|devin"; exit 2 ;;
        esac
        shift 2
        ;;
      --claude) HIVE_LAUNCHER=cf; shift ;;
      --codex)  HIVE_LAUNCHER=cxscb; shift ;;
      --devin)  HIVE_LAUNCHER=deo; shift ;;
      --co)     HIVE_LAUNCHER=co; shift ;;
      --cf)     HIVE_LAUNCHER=cf; shift ;;
      *) break ;;
    esac
  done

  local cmd="${1:-sync}"
  (( $# )) && shift

  hive_source_engines

  case "$cmd" in
    help|-h|--help) hive_usage; exit 0 ;;
    snapshot)       hive_snapshot "$@"; exit $? ;;
    plan)           hive_plan "$@"; exit $? ;;
    apply)          hive_apply "$@"; exit $? ;;
    status)         hive_status "$@"; exit $? ;;
    diff)           hive_diff "$@"; exit $? ;;
    doctor)         hive_doctor "$@"; exit $? ;;
    golden)
      local sub="${1:-}"
      (( $# )) && shift
      case "$sub" in
        init)     hive_golden_init "$@"; exit $? ;;
        finalize) hive_golden_finalize "$@"; exit $? ;;
        *) print -ru2 -- "hive golden: expected init|finalize"; exit 2 ;;
      esac
      ;;
    sync)
      hive_require_profiles
      local prompt
      prompt=$(hive_build_prompt)
      hive_launch "$prompt"
      ;;
    *)
      print -ru2 -- "hive: unknown command: ${cmd}"
      hive_usage >&2
      exit 2
      ;;
  esac
}

main "$@"
